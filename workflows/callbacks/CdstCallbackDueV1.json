{
  "id": "CdstCallbackDueV1",
  "name": "CDA-WF-20 Callback Due",
  "active": false,
  "nodes": [
    {
      "id": "manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        -80
      ],
      "parameters": {}
    },
    {
      "id": "schedule",
      "name": "Inactive Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        80
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "due",
      "name": "GET Due Callbacks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "url": "http://middleware:8095/api/v1/automation/callbacks/due",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Request-ID",
              "value": "={{$json.request_id}}"
            },
            {
              "name": "X-Correlation-ID",
              "value": "={{$json.correlation_id}}"
            }
          ]
        }
      }
    },
    {
      "id": "filter",
      "name": "Filter TEST_SYN Scheduled Callbacks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const now=Date.now();return ($json.items||[]).filter(c=>c.status==='scheduled'&&c.campaign_id==='TEST_SYN'&&!c.dispatched_at&&c.assigned_agent_id).map(c=>({json:{...c,category:new Date(c.scheduled_at).getTime()<now?'overdue':c.priority==='high'?'high_priority':'due',supervisor_escalation:new Date(c.scheduled_at).getTime()<now}}));"
      }
    },
    {
      "id": "preview",
      "name": "Build Notification Preview",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "return items.map(i=>({json:{request_id:i.json.request_id||'req_callback_test',correlation_id:i.json.callback_id, campaign_id:'TEST_SYN',preview:i.json}}));"
      }
    },
    {
      "id": "post",
      "name": "POST Notification Preview",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "url": "http://middleware:8095/api/v1/automation/actions/notifications/preview",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Request-ID",
              "value": "={{$json.request_id}}"
            },
            {
              "name": "X-Correlation-ID",
              "value": "={{$json.correlation_id}}"
            }
          ]
        },
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json}}"
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "GET Due Callbacks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Inactive Schedule Trigger": {
      "main": [
        [
          {
            "node": "GET Due Callbacks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET Due Callbacks": {
      "main": [
        [
          {
            "node": "Filter TEST_SYN Scheduled Callbacks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter TEST_SYN Scheduled Callbacks": {
      "main": [
        [
          {
            "node": "Build Notification Preview",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Notification Preview": {
      "main": [
        [
          {
            "node": "POST Notification Preview",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "CdstErrorDeadLetterV1",
    "timezone": "America/Santo_Domingo",
    "saveExecutionProgress": true
  },
  "meta": {
    "sprint": 1,
    "environment": "test",
    "campaign_allowlist": [
      "TEST_SYN"
    ],
    "middleware_only": true,
    "request_id_required": true,
    "correlation_id_required": true,
    "retry_policy_seconds": [
      30,
      120,
      600,
      1800
    ],
    "preview_only": true,
    "signature_verification": true
  },
  "tags": [
    {
      "name": "codestra-sprint-1"
    },
    {
      "name": "inactive-blueprint"
    }
  ]
}
