{
  "name": "N8N-22 Credential Delivery and Expiration",
  "active": false,
  "settings": {"executionOrder": "v1", "saveDataErrorExecution": "all"},
  "nodes": [
    {"id": "manual", "name": "Synthetic Input", "type": "n8n-nodes-base.manualTrigger", "typeVersion": 1, "position": [0, 0], "parameters": {}},
