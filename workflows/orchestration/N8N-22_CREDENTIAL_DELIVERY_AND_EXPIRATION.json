    {"id": "audit", "name": "Audit Metadata Only", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [440, 0], "parameters": {"method": "POST", "url": "={{$env.MIDDLEWARE_INTERNAL_URL}}/api/v1/automation/events", "sendBody": true, "jsonBody": "={{$json}}", "options": {"timeout": 10000}}, "credentials": {"httpHeaderAuth": {"id": "codestraMiddlewareBearer", "name": "Codestra Middleware Bearer"}}}
  ],
  "connections": {"Synthetic Input": {"main": [[{"node": "Reject Secret Material", "type": "main", "index": 0}]]}, "Reject Secret Material": {"main": [[{"node": "Audit Metadata Only", "type": "main", "index": 0}]]}},
  "meta": {"environment": "staging", "owner": "Ralph Appolon", "business_unit_scope": "explicit", "bounded_retries": 0, "production_write_guard": true, "credential_reference": "codestraMiddlewareBearer", "no_credentials": true, "one_time_retrieval": true, "password_email_forbidden": true, "sensitive_field_masking": true}
