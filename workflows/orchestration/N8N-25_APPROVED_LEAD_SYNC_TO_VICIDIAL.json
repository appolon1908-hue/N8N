  "connections": {"Synthetic Input": {"main": [[{"node": "Production Write Guard", "type": "main", "index": 0}]]}, "Production Write Guard": {"main": [[{"node": "Persist Disabled Lead Sync", "type": "main", "index": 0}]]}},
