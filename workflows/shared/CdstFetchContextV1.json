{
  "id": "CdstFetchContextV1",
  "name": "CDA-SW-03 Fetch Context",
  "active": false,
  "nodes": [
    {
      "id": "trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "route",
      "name": "Validate Context Route",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const allowed=['calls','leads','timeline','agents','campaigns','callbacks/due','reports/daily-operations'];if(!allowed.includes($json.context_type))throw new Error('validation_error:context_type');const id=$json.identifier?'/'+encodeURIComponent($json.identifier):'';return [{json:{...$json,context_url:'http://middleware:8095/api/v1/automation/context/'+$json.context_type+id}}];"
      }
    },
    {
      "id": "get",
      "name": "GET Middleware Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "url": "={{$json.context_url}}",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Request-ID",
              "value": "={{$json.request_id}}"
            },
            {
              "name": "X-Correlation-ID",
              "value": "={{$json.correlation_id}}"
            }
          ]
        }
      }
    },
    {
      "id": "structured",
      "name": "Return Structured Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "return [{json:{ok:true,context:$json}}];"
      }
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Validate Context Route",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Context Route": {
      "main": [
        [
          {
            "node": "GET Middleware Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET Middleware Context": {
      "main": [
        [
          {
            "node": "Return Structured Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "CdstErrorDeadLetterV1",
    "timezone": "America/Santo_Domingo",
    "saveExecutionProgress": true
  },
  "meta": {
    "sprint": 1,
    "environment": "test",
    "campaign_allowlist": [
      "TEST_SYN"
    ],
    "middleware_only": true,
    "request_id_required": true,
    "correlation_id_required": true,
    "retry_policy_seconds": [
      30,
      120,
      600,
      1800
    ]
  },
  "tags": [
    {
      "name": "codestra-sprint-1"
    },
    {
      "name": "inactive-blueprint"
    }
  ]
}
