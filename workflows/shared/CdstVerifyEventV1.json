      "name": "Validate Event Version",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "if($json.event_version!=='1.0')throw new Error('validation_error:unsupported_event_version');return items;"
      }
    },
    {
      "id": "environment",
      "name": "Validate Environment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
