{
  "id": "CdstDailyOperationsDigestV1",
  "name": "CDA-WF-70 Daily Operations Digest",
  "active": false,
  "nodes": [
    {
      "id": "manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        -80
      ],
      "parameters": {}
    },
    {
      "id": "schedule",
      "name": "Inactive Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        80
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 7
            }
          ]
        }
      }
    },
    {
      "id": "fetch",
      "name": "GET Daily Operations Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "url": "http://middleware:8095/api/v1/reports/daily-operations",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Request-ID",
              "value": "={{$json.request_id}}"
            },
            {
              "name": "X-Correlation-ID",
              "value": "={{$json.correlation_id}}"
            }
          ]
        }
      }
    },
    {
      "id": "validate",
      "name": "Validate Report Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "if(!$json.report_date||!$json.kpis)throw new Error('validation_error:daily_report');return items;"
      }
    },
    {
      "id": "render",
      "name": "Render JSON HTML CSV and Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "const k=$json.kpis;const rows=Object.entries(k).map(([a,b])=>a+','+b);return [{json:{normalized:$json,html:'<!doctype html><html><body><h1>Codestra Daily Operations</h1><p>'+JSON.stringify(k)+'</p></body></html>',csv:['metric,value',...rows].join('\\n'),text:'Codestra Daily Operations '+JSON.stringify(k)}}];"
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "GET Daily Operations Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Inactive Schedule Trigger": {
      "main": [
        [
          {
            "node": "GET Daily Operations Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET Daily Operations Report": {
      "main": [
        [
          {
            "node": "Validate Report Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Report Response": {
      "main": [
        [
          {
            "node": "Render JSON HTML CSV and Text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "CdstErrorDeadLetterV1",
    "timezone": "America/Santo_Domingo",
    "saveExecutionProgress": true
  },
  "meta": {
    "sprint": 1,
    "environment": "test",
    "campaign_allowlist": [
      "TEST_SYN"
    ],
    "middleware_only": true,
    "request_id_required": true,
    "correlation_id_required": true,
    "retry_policy_seconds": [
      30,
      120,
      600,
      1800
    ],
    "render_only": true,
    "signature_verification": true
  },
  "tags": [
    {
      "name": "codestra-sprint-1"
    },
    {
      "name": "inactive-blueprint"
    }
  ]
}
