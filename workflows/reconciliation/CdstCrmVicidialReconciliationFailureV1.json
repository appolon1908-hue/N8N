{
  "id": "CdstCrmVicidialReconciliationFailureV1",
  "name": "W19 CRM–VICIdial Reconciliation Failure Release",
  "active": false,
  "nodes": [
    {
      "id": "error",
      "name": "Reconciliation Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {}
    },
    {
      "id": "sanitize",
      "name": "Build Safe Failure Identity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0],
      "parameters": {
        "jsCode": "const execution=$json.execution||{};const correlation_id=String(execution.id||$json.correlation_id||'');if(!correlation_id)throw new Error('correlation_id_required');const message=String(execution.error?.message||$json.error?.message||'reconciliation_failed').replace(/(password|secret|token|authorization)=[^ ]+/ig,'$1=[REDACTED]');return [{json:{correlation_id,error_code:message.split(':')[0],terminal:true}}];"
      }
    },
    {
      "id": "release",
      "name": "Fail and Release Reconciliation Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0],
      "parameters": {
        "method": "POST",
        "url": "http://middleware:8095/api/v1/crm-vicidial/reconciliation/fail-by-correlation",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "X-Correlation-ID", "value": "={{$json.correlation_id}}"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json}}",
        "options": {"timeout": 10000}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "codestraMiddlewareBearer",
          "name": "Codestra Middleware Bearer"
        }
      }
    }
  ],
  "connections": {
    "Reconciliation Error Trigger": {"main": [[{"node": "Build Safe Failure Identity", "type": "main", "index": 0}]]},
    "Build Safe Failure Identity": {"main": [[{"node": "Fail and Release Reconciliation Run", "type": "main", "index": 0}]]}
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Santo_Domingo",
    "saveExecutionProgress": true
  },
  "meta": {
    "sprint": 1,
    "environment": "test",
    "campaign_allowlist": ["TEST_SYN"],
    "middleware_only": true,
    "request_id_required": true,
    "correlation_id_required": true,
    "production_activation_approved": false,
    "releases_distributed_lock": true,
    "credential_reference": "codestraMiddlewareBearer"
  },
  "tags": [{"name": "codestra-sprint-1"}, {"name": "inactive-blueprint"}, {"name": "go-live-blocked"}]
}
