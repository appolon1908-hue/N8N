    "Apply Approved Connector Operations": {
      "main": [
        [
          {
            "node": "Persist Mapping Audit and Orphan Review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Persist Mapping Audit and Orphan Review": {
      "main": [
        [
          {
