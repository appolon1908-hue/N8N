          }
        ]
      ]
    },
    "Canonicalise and Deduplicate Revision Batch": {
      "main": [
        [
          {
            "node": "Resolve Identity and Detect Conflicts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resolve Identity and Detect Conflicts": {
      "main": [
        [
          {
            "node": "Verify Suppression Consent and Eligibility",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Suppression Consent and Eligibility": {
      "main": [
        [
          {
            "node": "Reserve Idempotent Actions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reserve Idempotent Actions": {
      "main": [
        [
          {
            "node": "Apply Approved Connector Operations",
            "type": "main",
