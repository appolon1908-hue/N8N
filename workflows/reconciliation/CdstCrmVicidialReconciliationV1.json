  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "CdstCrmVicidialReconciliationFailureV1",
    "timezone": "America/Santo_Domingo",
    "saveExecutionProgress": true
  },
  "meta": {
    "sprint": 1,
    "environment": "test",
    "campaign_allowlist": [
      "TEST_SYN"
    ],
    "middleware_only": true,
    "request_id_required": true,
    "correlation_id_required": true,
    "production_activation_approved": false,
    "distributed_lock": "postgresql",
    "cursor_overlap_seconds": 300,
    "suppression_fail_closed": true,
    "direct_vicidial_database_writes": false
  },
  "tags": [
    {
      "name": "codestra-sprint-1"
    },
    {
      "name": "inactive-blueprint"
    },
    {
      "name": "go-live-blocked"
    }
  ]
}
