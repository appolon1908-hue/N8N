{
  "schema": "codestra.n8n.workflow-contract.v2",
  "name": "MoneyBee borrower onboarding",
  "active": false,
  "trigger": {
    "source": "middleware",
    "eventType": "codestra.moneybee.account.provisioned",
    "schemaVersion": 1,
    "requiredAudience": "n8n-automation",
    "requiredScope": "workflow.trigger"
  },
  "ownership": {
    "workflowOwner": "n8n",
    "baseCrmProjectionOwner": "middleware",
    "baseCrmProjectionCommand": "crm.contact.upsert.v1",
    "mayRequestBaseCrmProjection": false
  },
  "input": {
    "required": ["id", "type", "source", "subject", "tenant_id", "correlation_id", "causation_id", "idempotency_key", "schema_version", "data.user_id", "data.organization_id", "data.email_verified"],
    "requireEmailVerified": true,
    "prohibitedFields": ["password", "verification_code", "otp", "reset_token", "access_token", "refresh_token"]
  },
  "steps": [
    {
      "id": "validate-event",
      "type": "validation",
      "failClosed": true,
      "idempotencyKey": "idempotency_key"
    },
    {
      "id": "create-onboarding-task",
      "type": "middleware-command",
      "target": "middleware-api",
      "command": "onboarding.task.create.v1",
      "requiredScope": "workflow.result.publish"
    },
    {
      "id": "marketing-consent-branch",
      "type": "conditional",
      "condition": "data.marketing_consent == true",
      "whenTrue": "request-marketing-enrollment",
      "whenFalse": "complete"
    },
    {
      "id": "request-marketing-enrollment",
      "type": "middleware-command",
      "target": "middleware-api",
      "command": "marketing.contact.enrollment.requested.v1",
      "requiredScope": "workflow.result.publish"
    }
  ],
  "safety": {
    "directOdooAccess": false,
    "directKlyrowAccess": false,
    "directPostalAccess": false,
    "keycloakAdminAccess": false,
    "securityEmailSynchronousPath": false,
    "duplicateBaseCrmProjection": false,
    "productionActivation": "requires-separate-reviewed-deployment"
  }
}
