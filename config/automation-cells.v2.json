{
  "schema_version": "2.0",
  "state": "DESIGN_ONLY",
  "cells": [
    {
      "id": "n8n-core",
      "database": "n8n_core",
      "redis_namespace": "n8n:core",
      "machine_clients": ["n8n-platform-runtime", "n8n-identity-automation", "n8n-crm-automation", "n8n-messaging-automation", "n8n-social-automation", "n8n-crawler-automation", "n8n-privacy-automation", "n8n-operations-automation"],
      "workflow_families": ["platform.shared", "identity", "provisioning", "crm", "support", "messaging.email", "messaging.sms", "social.postly", "crawler.kyqra", "privacy", "operations"],
      "allowed_egress": ["middleware-core.internal.invalid"]
    },
    {
      "id": "n8n-products",
      "database": "n8n_products",
      "redis_namespace": "n8n:products",
      "machine_clients": ["n8n-product-automation"],
      "workflow_families": ["product.moneybee", "product.breero", "product.larim-a", "product.freight", "product.beyvra-nonfinancial", "product.booked4seasons", "product.trading-nonfinancial"],
      "allowed_egress": ["middleware-products.internal.invalid"],
      "forbidden_command_prefixes": ["trade.", "order.", "wallet.", "ledger.", "hold.", "payment.", "withdrawal.", "deposit.", "transfer.", "custody.", "chain.", "broker.", "provider."]
    },
    {
      "id": "n8n-contact-center",
      "database": "n8n_contact_center",
      "redis_namespace": "n8n:contact-center",
      "machine_clients": ["n8n-telephony-automation"],
      "workflow_families": ["telephony"],
      "allowed_egress": ["middleware-telephony.internal.invalid"],
      "public_webhooks": false
    }
  ],
  "invariants": {
    "direct_provider_access": false,
    "direct_database_access": false,
    "public_n8n_webhooks": false,
    "workflows_active_in_git": false,
    "credentials_in_git": false
  }
}
