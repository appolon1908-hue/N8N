{
  "schema_version": "2.0",
  "baseline": {
    "repository": "appolon1908-hue/N8N",
    "branch": "platform/services-middleware-automations-designs",
    "required_before_feature_branches": true
  },
  "merge_order": [
    "Middleware-/core/integration-contracts",
    "Middleware-/platform/postgresql",
    "Middleware-/platform/redis",
    "Middleware-/integration/keycloak",
    "Middleware-/core/event-ledger-outbox",
    "Middleware-/core/webhook-inbox-replay",
    "Middleware-/core/workers-scheduler",
    "Middleware-/integration/n8n",
    "N8N/contract/automation-control-plane-v2",
    "N8N/shared/automation-runtime",
    "relevant Middleware adapter branch",
    "matching N8N automation branch",
    "N8N/operations/reconciliation",
    "N8N/observability/n8n",
    "N8N/release/automation-v1"
  ],
  "n8n_branches": [
    "contract/automation-control-plane-v2",
    "platform/runtime-path-verification",
    "platform/n8n-runtime-policy",
    "platform/n8n-queue-mode",
    "platform/n8n-editor-identity",
    "platform/n8n-secrets",
    "shared/automation-runtime",
    "automation/identity-provisioning",
    "automation/odoo-crm",
    "automation/vicidial-telephony",
    "automation/telnexa-sms",
    "automation/klyrow-email",
    "automation/kyqra-crawler",
    "automation/postly-social",
    "automation/moneybee-loans",
    "automation/breero-marketplace",
    "automation/larim-a-booking",
    "automation/freight-operations",
    "automation/beyvra",
    "operations/human-approvals",
    "operations/retry-dead-letter",
    "operations/reconciliation",
    "operations/incident-alerting",
    "operations/release-canary",
    "privacy/data-rights",
    "observability/n8n",
    "testing/contract-fixtures",
    "testing/staging-no-effect-e2e",
    "release/automation-v1"
  ],
  "rules": {
    "direct_deploy_from_feature_branch": false,
    "workflows_active_in_git": false,
    "credentials_in_git": false,
    "public_n8n_webhooks": false,
    "direct_service_nodes": false,
    "middleware_contract_must_merge_first": true,
    "exact_head_ci_and_approval": true,
    "immutable_release_from_protected_sha": true
  }
}
