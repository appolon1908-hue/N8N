# Non-secret recovery identity fields required by codestra-n8n-recovery-backup.
# Copy these names into the root-owned database-certification.env during the
# reviewed rollout and replace every placeholder with the approved exact value.
# Secret values and database credentials must continue to come from the
# existing protected delivery authority; never commit them here.
CODESTRA_DATABASE_BACKUP_GPG_SIGNING_FINGERPRINT=REPLACE_WITH_40_HEX_FINGERPRINT
CODESTRA_RELEASE_SHA=REPLACE_WITH_40_HEX_RELEASE_SHA
CODESTRA_N8N_PRODUCTION_IMAGE_DIGEST=sha256:REPLACE_WITH_64_HEX_DIGEST
CODESTRA_N8N_STAGING_IMAGE_DIGEST=sha256:REPLACE_WITH_64_HEX_DIGEST

# Isolated restore-only targets. URLs must not contain passwords or query
# overrides. Passfiles remain root-owned secret delivery artifacts.
CODESTRA_DATABASE_BACKUP_GPG_HOME=/etc/codestra/backup-gpg
N8N_RECOVERY_WORK_ROOT=/run/codestra/n8n-recovery-work
N8N_PRODUCTION_RESTORE_URL=postgresql://restore@isolated.internal:5432/codestra_n8n_restore
N8N_PRODUCTION_RESTORE_PGPASSFILE=/etc/codestra/backup/production-restore.pgpass
N8N_STAGING_RESTORE_URL=postgresql://restore@isolated.internal:5432/n8n_staging_restore
N8N_STAGING_RESTORE_PGPASSFILE=/etc/codestra/backup/staging-restore.pgpass
