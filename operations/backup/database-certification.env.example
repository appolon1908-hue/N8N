# Non-secret recovery identity fields required by codestra-n8n-recovery-backup.
# Copy these names into the root-owned database-certification.env during the
# reviewed rollout and replace every placeholder with the approved exact value.
# Secret values and database credentials must continue to come from the
# existing protected delivery authority; never commit them here.
CODESTRA_DATABASE_BACKUP_GPG_SIGNING_FINGERPRINT=REPLACE_WITH_40_HEX_FINGERPRINT
CODESTRA_RELEASE_SHA=REPLACE_WITH_40_HEX_RELEASE_SHA
CODESTRA_N8N_PRODUCTION_IMAGE_DIGEST=sha256:REPLACE_WITH_64_HEX_DIGEST
CODESTRA_N8N_STAGING_IMAGE_DIGESTS=sha256:REPLACE_WITH_64_HEX_DIGEST
