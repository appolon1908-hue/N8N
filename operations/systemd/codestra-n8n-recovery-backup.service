[Unit]
Description=Complete encrypted n8n recovery-point backup
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/codestra/backup/database-certification.env
ExecStart=/opt/codestra/operations/backup/n8n-recovery-backup.sh
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/codestra/backups /var/lib/docker/volumes
NoNewPrivileges=true
TimeoutStartSec=30min
